<%- include("partials/header", { title: "Recipes" }) %>

<main class="main-content">
  <% if (currentUser.role === "admin") { %>
  <h2 class="recipe-list-title">Recipes</h2>
  <% } else { %>
  <h2 class="recipe-list-title">
    <%= currentUser.username %>'s Recipes
  </h2>
  <% } %>

  <% if (recipes.length === 0) { %>
  <p>No recipes found.</p>
  <% } else { %>
  <ul class="recipe-list">
    <% recipes.forEach((recipe) => { %>
    <li class="recipe-list-card">
      <a class="recipe-card-link" href="/recipes/<%= recipe.id %>">
        <h3>
          <%= recipe.name %>
        </h3>

        <% if (currentUser.role === "admin") { %>
        <p>Created by: <%= recipe.creatorUsername %></p>
        <% } %>
      </a>
    </li>
    <% }); %>
  </ul>
  <% } %>

  <p><a href="/recipes/new">Create New Recipe</a></p>
</main>

<%- include("partials/footer") %>
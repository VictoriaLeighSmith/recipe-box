<%- include('partials/header', { title: "Recipe Box", currentUser }) %>

<main class="main-content">
  <% if (currentUser) { %>
  <p>Welcome, <%= currentUser.username %>!</p>

  <a href="/recipes">Go To Recipes</a>
  <% } else { %>
  <p class="home-page-info">Store and manage your favorite recipes!</p>

  <span class="index-button-container">
    <button onclick="window.location.href='/signup'">Sign Up</button>
  </span>
  <% } %>
</main>

<%- include('partials/footer') %>
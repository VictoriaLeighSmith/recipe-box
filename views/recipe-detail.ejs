<%- include("partials/header", { title: recipe.name }) %>

<main class="main-content">

  <article class="recipe-detail">
    <h2 class="recipe-detail-title"><%= recipe.name %></h2>
    <hr />

    <section class="recipe-detail-section">
      <h3>Ingredients</h3>
      <p><%= recipe.ingredients %></p>
    </section>

    <section class="recipe-detail-section">
      <h3>Instructions</h3>
      <p><%= recipe.instructions %></p>
    </section>

    <p class="recipe-detail-meta">
      Created by: <%= recipe.creatorUsername %>
    </p>

    <% if (typeof canDelete !== "undefined" && canDelete) { %>
    <form class="delete-recipe-form" action="/recipes/<%= recipe.id %>/delete" method="POST">
      <button class="login-signup-button" type="submit" onclick="return confirm('Are you sure you want to delete this recipe?')">
        Delete Recipe
      </button>
    </form>
    <% } %>
  </article>

  <p class="go-back">
    <a href="/recipes"><svg width="12px" height="12px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>Back to My Recipes</a>
  </p>

</main>

<%- include("partials/footer") %>
<%- include('partials/header', { title: recipe.name }) %>
    <div class="recipe-detail">
        <h1><%= recipe.name %></h1>

        <div class="section-title">Ingredients</div>
        <p><%= recipe.ingredients %></p>

        <div class="section-title">Instructions</div>
        <p><%= recipe.instructions %></p>

        <div class="meta">Created by: <%= recipe.creatorUsername %></div>

        <% if (typeof canDelete !== 'undefined' && canDelete) { %>
            <form action="/recipes/<%= recipe.id %>/delete" method="POST" style="margin-top: 20px;">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this recipe?')">Delete Recipe</button>
            </form>
        <% } %>
    </div>
    <p><a href="/recipes">Back to My Recipes</a></p>
<%- include('partials/footer') %>
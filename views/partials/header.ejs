<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <nav class="navbar">
    <% if (currentUser) { %>
    <div class="nav-logged-in">
      <div class="nav-links">
        <a href="/recipes"> My Recipes</a>
        <a href="/recipes/new">Add Recipe</a>
      </div>

      <div class="main-title">
        <a href="/">
          <h1>RECIPE BOX</h1>
        </a>
      </div>

      <div class="user-actions">
        <a href="/logout">Logout</a>
      </div>
    </div>
    <% } else { %>
    <div class="nav-logged-out">
      <div class="nav-links">
      </div>

      <div class="main-title">
        <a href="/">
          <h1>RECIPE BOX</h1>
        </a>
      </div>

      <div class="user-actions">
        <a href="/login">Login</a>
      </div>
    </div>
    <% } %>
  </nav>

  <img class="flowers flowers-top-left" src="/images/flowers-top-left.png" alt="" aria-hidden="true">
  <img class="flowers flowers-bottom-right" src="/images/flowers-bottom-right.png" alt="" aria-hidden="true">